# Copy to .env and fill in. docker-compose and the local run both read .env.

# Bot token from @BotFather. Use a bot of its own: two programs polling the
# same token steal each other's updates.
BOT_TOKEN=123456789:AA-your-token-here

# Telegram numeric ids allowed to use the bot; everyone else is ignored.
# Required, since the bot downloads any link it is sent.
# Get yours from @userinfobot. Comma-separate to allow more than one.
ALLOWED_USERS=123456789
